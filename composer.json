{
    "name": "drymhd/sso-client-ukurir",
    "description": "Official Laravel Single Sign-On (SSO) Client SDK for SAI & uKurir Ecosystem",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "drymhd",
            "email": "dev@saitrans.id"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "firebase/php-jwt": "^6.8|^7.0"
    },
    "replace": {
        "saitrans/sso-client": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Saitrans\\SsoClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saitrans\\SsoClient\\SsoClientServiceProvider"
            ],
            "aliases": {
                "SSO": "Saitrans\\SsoClient\\Facades\\SSO"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
