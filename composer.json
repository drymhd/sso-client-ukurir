{
    "name": "saitrans/sso-client",
    "description": "Official Laravel Single Sign-On (SSO) Client SDK for SAI Enterprise Ecosystem",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "PT Sumber Alfaria Trijaya",
            "email": "dev@saitrans.id"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/auth": "^10.0|^11.0",
        "firebase/php-jwt": "^6.8"
    },
    "autoload": {
        "psr-4": {
            "Saitrans\\SsoClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saitrans\\SsoClient\\SsoClientServiceProvider"
            ],
            "aliases": {
                "SSO": "Saitrans\\SsoClient\\Facades\\SSO"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
